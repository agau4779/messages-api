# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore the master key used to decrypt credentials.
/config/*.key

# Ignore the SQLite databases (and their journal/WAL files).
/storage/*
!/storage/.keep
*.sqlite3
*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore OS and editor files.
.DS_Store
*.swp
.idea/
.vscode/
